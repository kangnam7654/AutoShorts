# AutoShorts Configuration
# See docs/configuration.md for details.
# Copy this file: cp .env.example .env

# =============================================================================
# Veo Pipeline (primary)
# =============================================================================

# Google AI API key — required for Veo video generation
GOOGLE_API_KEY=""

# Veo model ID (default: veo-3.1-generate-preview)
VEO_MODEL="veo-3.1-generate-preview"

# Vertex AI mode (set to "true" for production)
VEO_USE_VERTEX="false"
GOOGLE_CLOUD_PROJECT=""

# GCS bucket for Vertex output
VEO_GCS_BUCKET=""

# API polling timeout in seconds
VEO_MAX_WAIT_SECONDS="600"

# =============================================================================
# Stock Footage Pipeline (legacy)
# =============================================================================

# TikTok session cookie for TTS
TIKTOK_SESSION_ID=""

# Pexels API key for stock video search
PEXELS_API_KEY=""

# ImageMagick binary path (leave empty to auto-detect)
IMAGEMAGICK_BINARY=""

# =============================================================================
# LLM / AI Provider
# =============================================================================

# Provider: ollama, openai, or codex
AI_PROVIDER="ollama"

# Ollama settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=""

# =============================================================================
# TTS Provider
# =============================================================================

# Provider: tiktok, qwen, or clone
TTS_PROVIDER="tiktok"

# =============================================================================
# Database (Docker only)
# =============================================================================

# Leave DATABASE_URL empty for local SQLite default.
POSTGRES_DB="moneyprinter"
POSTGRES_USER="moneyprinter"
POSTGRES_PASSWORD=""
DATABASE_URL=""
